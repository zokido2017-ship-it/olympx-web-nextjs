# Firebase web app config — NEVER commit `.env.local` with real secrets to git.

## Quick steps
1. In the project root, copy this file:  
   **`cp .env.example .env.local`** (macOS/Linux) or copy/paste manually on Windows.
2. Open Firebase Console → your Project → ⚙️ **Project settings** → **Your apps** → select or add a **Web app** (`</>`).
3. Paste the **`firebaseConfig`** values into the matching `NEXT_PUBLIC_*` keys below.
4. Restart the dev server: stop `npm run dev` and run it again.  
   (**Next.js bakes `NEXT_PUBLIC_*` at startup** — edits to `.env.local` are ignored until restart.)

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Laravel / Olympx API (server-side proxy — do not commit real secrets)
# Next.js proxies browser calls: /api/olympx/<path> → {OLYMPEX_API_BASE_URL}/<path>
# Use 127.0.0.1 (not localhost) on Windows to avoid Docker/WSL grabbing [::1]:8000.
# Run only one listener on 8000: `php artisan serve --host=127.0.0.1 --port=8000`
OLYMPEX_API_BASE_URL=http://127.0.0.1:8000
# Laravel upstream timeout from Next route handlers (ms). Raise if validate-otp is slow locally.
OLYMPEX_UPSTREAM_TIMEOUT_MS=45000
#
# If Laravel returns: "could not find driver (Connection: pgsql, ...)"
# → fix PHP on the machine running `php artisan serve`, not this Next app:
#   Windows: enable extension=pdo_pgsql and extension=pgsql in php.ini, ensure libpq.dll is available (PHP folder or PostgreSQL bin in PATH), then restart.
#   Linux: sudo apt install php-pgsql (or php8.x-pgsql) and restart PHP-FPM / Apache.
#   Or point Laravel .env DB_CONNECTION to a driver your PHP build has (e.g. mysql, sqlite).

# Dev only: skip middleware + dashboard/profile auth guard (open /dashboard without login).
# NEXT_PUBLIC_OLYMPX_AUTH_BYPASS=true  # no longer disables hub auth (see auth-enforced-paths.ts)
# NEXT_PUBLIC_AUTH_DEBUG=1            # structured [auth-flow:*] + [auth-flow:trace] logs
#
# TODO: Remove — temporary dev workaround. After OTP, skip session cookie confirmation and
# allow /organizations/* with client-side token only. On by default in development.
# NEXT_PUBLIC_OLYMPX_DEV_SKIP_SESSION_CONFIRM=false

# Optional: override default API paths (relative to OLYMPEX_API_BASE_URL)
# NEXT_PUBLIC_OLYMPX_SEND_OTP_PATH=api/v1/auth/send-otp
# NEXT_PUBLIC_OLYMPX_VERIFY_OTP_PATH=api/v1/auth/validate-otp
NEXT_PUBLIC_OLYMPX_REGISTER_PATH=api/v1/auth/register
