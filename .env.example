# Sportxo backend API (v1)
# Production: https://backend.sportxo.in/api/v1
# Local dev:  http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=https://backend.sportxo.in/api/v1

# Optional override for non-v1 routes such as GET /api/me
# NEXT_PUBLIC_API_ORIGIN=https://backend.sportxo.in

# Google OAuth (Web client ID from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Dev OTP — pre-filled in forms; bypasses API validation when backend rejects it
NEXT_PUBLIC_DEFAULT_OTP=0000
NEXT_PUBLIC_ENABLE_DEV_OTP=true
